# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/localtask?sslmode=disable

# AWS Cognito
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-northeast-1

# AWS S3
AWS_S3_BUCKET=localtask-uploads-dev
AWS_S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=60
RATE_LIMIT_UPLOAD=5

# CORS
CORS_ORIGIN=http://localhost:19006

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_strong_password

# Weekly Digest Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@locallyhelper.com
DIGEST_SECRET=generate_a_long_random_string
UNSUBSCRIBE_SECRET=generate_another_long_random_string
# App site root (for the "view in app" button)
APP_PUBLIC_URL=https://locallyhelper.com
# Backend API base behind nginx /api (for the unsubscribe link)
API_PUBLIC_URL=https://locallyhelper.com/api

# Marketplace draft from Xiaohongshu (小红书) posts (admin-only feature)
# Name of the lambda-xhs-scraper Lambda function (see lambda-xhs-scraper/README.md)
XHS_SCRAPER_LAMBDA_NAME=localtask-xhs-scraper
AWS_LAMBDA_REGION=ap-northeast-1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# users.id of a real app account that admin-published marketplace listings are
# posted under (admin has no Cognito identity of its own; create one dedicated
# account in the app once and put its id here)
MARKETPLACE_OFFICIAL_USER_ID=
